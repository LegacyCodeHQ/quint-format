// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`namespace access and assignments formats namespace access 1`] = `
"module Example {
  pure val apply = (Scope::x) => Scope::x
}
"
`;

exports[`namespace access and assignments formats a primed assignment 1`] = `
"module Example {
  var count: int

  action increment = count' = count + 1
}
"
`;

exports[`namespace access and assignments preserves an explicit line break in a primed assignment chain 1`] = `
"module Example {
  type State = { first: int, second: int }
  var state: State

  action update = all {
    state' =
      state.with("first", 1)
          .with("second", 2),
  }
}
"
`;
