exports[`UFCS and member access preserves a comment before a field selector 1`] = `
"module Example {
  pure val source = { field: 1 }
  pure val answer = source
      // Preserve this chain comment.
      .field
}
"
`;

exports[`UFCS and member access aligns comments with a continued UFCS selector 1`] = `
"module Example {
  action init = true
  action step = true

  run execution =
    init
        // Explain the first transition.
        // Keep this attached to the call.
        .then(step)
}
"
`;
