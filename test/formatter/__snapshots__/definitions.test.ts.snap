// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`definitions formats a general assumption expression 1`] = `
"module Example {
  const Flag: bool

  assume Holds = Flag
}
"
`;

exports[`definitions formats a parameterless def definition 1`] = `
"module Example {
  def answer = 42
}
"
`;

exports[`definitions formats a def parameter 1`] = `
"module Example {
  def identity(value) = value
}
"
`;

exports[`definitions formats an ignored def parameter 1`] = `
"module Example {
  pure def ignore(_: int): int = 0
}
"
`;

exports[`definitions formats multiple def parameters 1`] = `
"module Example {
  def choose(left, right) = left
}
"
`;

exports[`definitions preserves a trailing comma in a compact pure def parameter list 1`] = `
"module Example {
  pure def choose(left: int, right: int,): int = left
}
"
`;

exports[`definitions preserves an expanded pure def parameter list without a trailing comma 1`] = `
"module Example {
  pure def choose(
    left: int,
    right: int
  ): int = left
}
"
`;

exports[`definitions formats a typed def header 1`] = `
"module Example {
  def identity(value: int) : int = value
}
"
`;

