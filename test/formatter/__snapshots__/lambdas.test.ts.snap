// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`lambdas formats lambda parameter forms 1`] = `
"module Example {
  pure val identity = x => x

  pure val add = (x, y) => x + y

  pure val sumPair = ((x, y)) => x + y
}
"
`;

exports[`lambdas uses a four-space continuation for a multiline lambda body 1`] = `
"module Example {
  pure val total = Set(1).fold(0, (sum, value) =>
      sum + value)
}
"
`;

exports[`lambdas preserves a multiline call with a lambda argument 1`] = `
"module Example {
  const names: Set[str]

  val all_present = names.forall(name =>
    names.contains(name)
  )
}
"
`;

