  pure val valid = Set(1, 2).forall(value =>
    (value > 0)
        implies (value >= 1)
  )
}
"
`;

exports[`lambdas keeps a secondary lambda header beside the call opening 1`] = `
"module Example {
  var values: str -> int

  action update = {
    values' = values.setBy("one", value =>
      value + 1
    )
  }
}
"
`;

exports[`lambdas keeps leading call arguments beside a multiline lambda 1`] = `
"module Example {
  pure val folded =
    0.range(8)
        .foldl(Map(),
          (m, key) =>
            if (key > 0) m.put(key, key) else m
        )
}
"
`;

exports[`lambdas stabilizes lambda indentation when its call expands 1`] = `
"module Example {
  pure def update(values: Set[int]): Set[int] =
    values.fold(
        Set(), (result, value) =>
          if (value > 0 and value > 1 and value > 2 and value > 3 and value > 4 and value > 5 and value > 6 and value > 7 and value > 8)
            val updated = result.union(Set(value))
            updated
          else
            result
    )
}
"
`;

exports[`lambdas propagates multiline layout through nested lambda calls 1`] = `
"module Example {
  type Result = Ok(int) | Err(str)

  pure def bind(result: Result, callback: int => Result): Result =
    match result {
      | Ok(value) => callback(value)
      | Err(_) => result
    }

  pure def combine(lhs: Result, rhs: Result): Result =
    lhs.bind(left =>
      rhs.bind(right =>
        if (left == right)
          Ok(left)
        else
          Err("different")
      )
    )
}
"
`;

exports[`lambdas keeps a block-bodied lambda brace beside its arrow 1`] = `
"module Example {
  pure def app(op: (int, int) => int, lhs: int, rhs: int): int = op(lhs, rhs)

  pure def absoluteDifference(lhs: int, rhs: int): int =
    ((x, y) => {
      val result = x - y
      if (result < 0) -result else result
    }).app(lhs, rhs)
}
"
`;

exports[`lambdas preserves a compact single-expression lambda block 1`] = `
"module Example {
  pure def listForall(list: List[a], pred: a => bool): bool = {
    list.foldl(true, (result, element) => { if (pred(element)) result else false })
  }
}
"
`;

