exports[`type declarations formats a primitive type alias 1`] = `
"module Example {
  type Count = int
}
"
`;

exports[`type declarations formats an uninterpreted type 1`] = `
"module Example {
  type DOMAIN
}
"
`;

exports[`type declarations formats a named type alias 1`] = `
