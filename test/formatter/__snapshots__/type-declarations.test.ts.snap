  type Elem = S(str) | I(int)
}
"
`;

exports[`type declarations formats a multiline sum type 1`] = `
"module Example {
  type Option[a] =
    | Some(a)
    | None
}
"
`;

exports[`type declarations preserves comments between sum-type variants 1`] = `
"module Example {
  type Step =
    | First
    // Preserve this variant comment.
    | Second
}
"
`;

exports[`type declarations preserves trailing comments on sum-type variants 1`] = `
