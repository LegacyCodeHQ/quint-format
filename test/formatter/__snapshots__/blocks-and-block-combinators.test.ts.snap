// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`blocks and block combinators formats an ordinary block expression 1`] = `
"module Example {
  var count: int

  action initialize = {
    count' = 0
  }
}
"
`;

exports[`blocks and block combinators preserves a comment inside an ordinary block 1`] = `
"module Example {
  action step = {
    // Preserve this block comment.
    true
  }
}
"
`;

exports[`blocks and block combinators preserves a trailing comment on an ordinary block result 1`] = `
"module Example {
  pure def choose = if (true) {
    1  // chosen result
  } else {
    2
  }
}
"
`;

exports[`blocks and block combinators formats all block combinators 1`] = `
"module Example {
  var count: int

  action choose = any { count' = 1, count' = 2 }

  action advance = all { count >= 0, count' = count + 1 }

  pure val both = and { true, false }

  pure val either = or { false, true }
}
"
`;

exports[`blocks and block combinators preserves a compact block combinator 1`] = `
"module Example {
  action first = true
  action second = false
  action choose = any { first, second }
}
"
`;

exports[`blocks and block combinators preserves source-line groups in block combinators 1`] = `
"module Example {
  val groupedAll = all {
    true, true, true,
  }

  val groupedAny = any {
    true, false, true,
  }

  pure val groupedAnd = and {
    true, true, false,
  }

  pure val groupedOr = or {
    false, false, true,
  }

  pure val longGroup = and {
    "first deliberately long value for width testing" == "first deliberately long value for width testing",
    "second deliberately long value for width testing" == "second deliberately long value for width testing",
  }
}
"
`;

exports[`blocks and block combinators preserves a block combinator below a definition header 1`] = `
"module Example {
  var n: int

  action step =
    all {
      n' = n,
      n >= 0,
    }
}
"
`;

exports[`blocks and block combinators removes a blank line after a block combinator opening 1`] = `
