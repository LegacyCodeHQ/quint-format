  }
}
"
`;

exports[`blocks and block combinators preserves aligned trailing comments in a block combinator 1`] = `
"module Example {
  var first: int
  var second: int
  var third: int
  var fourth: int

  action init = all {
    first' = 1,  // First value
    second' = 2, // Second value
    third' = 3,  // Third value
    fourth' = 4,  // Fourth value
  }
}
"
`;

exports[`blocks and block combinators preserves a blank line between block combinator entries 1`] = `
"module Example {
  var n: int

  action step = all {
    n >= 0,

    n' = n + 1,
  }
}
"
`;
