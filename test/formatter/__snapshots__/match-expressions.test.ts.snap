exports[`match expressions preserves a nested match arm body baseline 1`] = `
"module Example {
  type Inner = Leaf(int) | Internal(int)
  type Outer = Some(Inner) | None

  pure def evaluate(value: Outer): int = {
    match value {
      | Some(node) => match node {
          | Leaf(number) => number
          | Internal(number) => number + 1
        }
      | None => {
          0
        }
    }
  }
}
"
`;

exports[`match expressions preserves line-broken match arm baselines at every nesting level 1`] = `
"module Example {
  type Third = Value(int) | NoThird
  type Second = More(Third) | NoSecond
  type First = Next(Second) | NoFirst

  pure def evaluate(first: First): int =
      match first {
        | Next(second) =>
            match second {
              | More(third) =>
                  match third {
                    | Value(number) => number
                    | NoThird => 0
                  }
              | NoSecond => 0
            }
        | NoFirst => 0
      }
}
"
`;

exports[`match expressions uses a continuation indent for a line-broken nested match arm 1`] = `
"module Example {
  type Inner = Exist(int) | NonExist
  type Outer = Some(Inner) | None

  pure def verify(value: Outer): bool =
      match value {
        | Some(inner) =>
            match inner {
              | Exist(number) => number > 0
              | NonExist => true
            }
        | None => false
      }
}
"
`;

exports[`match expressions uses a four-space continuation for a line-broken match arm expression 1`] = `
"module Example {
  type Node = Leaf({ key_hash: int }) | Internal(int)
  type Proof = Exist(int) | NonExist

  pure def evaluate(proof: Proof, nodes: Set[Node], k: int): bool =
      match proof {
        | Exist(ep) =>
            nodes.filter(n => match n {
              | Leaf(n) => n.key_hash == k
              | Internal(_) => false
            }).size() > 0
        | NonExist => true
      }
}
"
`;

exports[`match expressions preserves record literal match-arm body indentation 1`] = `
"module Example {
  type Outcome = Updated(int) | Deleted

  pure def evaluate(outcome) = match outcome {
    | Updated(number) => {
        child: number,
        changed: true,
      }
    | Deleted => {
        child: 0,
        changed: false,
      }
  }
}
"
`;

exports[`match expressions preserves nested record literal match-arm body indentation 1`] = `
"module Example {
  type Optional = Some(int) | None
  type Outcome = Updated(int) | Unchanged(Optional)

  pure def evaluate(outcome, new_tree) = {
    match outcome {
      | Updated(number) => {
          ...new_tree,
          value: number,
        }
      | Unchanged(optional) => {
          match optional {
            | Some(number) => {
                ...new_tree,
                value: number,
              }
            | None => new_tree
          }
        }
      | _ => new_tree
    }
  }
}
"
`;

