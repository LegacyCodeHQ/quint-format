// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`match expressions formats a match expression 1`] = `
"module Example {
  type Option = Some(int) | None

  pure def getOrZero(value: Option): int = match value {
    | Some(x) => x
    | None => 0
    | _ => 0
  }
}
"
`;

exports[`match expressions joins a line-broken match arrow with one space 1`] = `
"module Example {
  type Node = Internal(int) | Leaf

  pure def value(node: Node): int =
      match node {
        | Internal(number) => number
        | Leaf => 0
      }
}
"
`;

exports[`match expressions preserves a compact one-arm default match 1`] = `
"module Example {
  val expected = match 42 { _ => "default" }
}
"
`;

exports[`match expressions places a match expression below a definition header 1`] = `
"module Example {
  type Status = Ready | Waiting
  var status: Status

  action step =
      match status {
        | Ready => { status' = Waiting }
        | Waiting => { status' = Ready }
      }
}
"
`;

exports[`match expressions preserves match placement after a definition equals sign 1`] = `
"module Example {
  type Option = Some(int) | None

  pure def inline(value: Option): int = match value {
    | Some(result) => result
    | None => 0
  }

  pure def expanded(value: Option): int =
      match value {
        | Some(result) => result
        | None => 0
      }
}
"
`;

exports[`match expressions preserves an inline multiline match used as a lambda body 1`] = `
"module InlineLambdaMatch {
  type Message = Msg(int) | Other

  pure def values(messages: Set[Message]): Set[int] =
      messages.fold(Set(), (acc, message) => match message {
        | Msg(value) => acc.union(Set(value))
        | _          => acc
      })
}
"
`;

exports[`match expressions aligns inline block-combinator bodies with the match case 1`] = `
"module Example {
  type Status = Ready | Waiting
  var status: Status
  var n: int

  action step =
      match status {
        | Ready => all {
            n' = n,
            status' = Waiting,
          }
        | Waiting => all {
            n' = n + 1,
            status' = Ready,
          }
      }
}
"
`;

exports[`match expressions aligns inline block-combinator bodies in nested matches 1`] = `
"module Example {
  type Inner = Exist(int) | NonExist
  type Outer = Some(Inner) | None

  pure def verify(value: Outer): bool =
      match value {
        | Some(inner) =>
            match inner {
              | Exist(n) => and {
                  n > 0,
                  n < 10,
                }
              | NonExist => true
            }
        | None => false
      }
}
"
`;

exports[`match expressions aligns an ordinary block body with the match case 1`] = `
"module Example {
  type Proof = Found(int) | Missing

  pure def verify(proof: Proof): bool =
      match proof {
        | Found(value) => {
            value > 0
          }
        | Missing => false
      }
}
"
`;

