exports[`formatter propagates multiline layout through nested lambda calls 1`] = `
"module Example {
  type Result = Ok(int) | Err(str)

  pure def bind(result: Result, callback: int => Result): Result =
    match result {
      | Ok(value) => callback(value)
      | Err(_) => result
    }

  pure def combine(lhs: Result, rhs: Result): Result =
    lhs.bind(left =>
      rhs.bind(right =>
        if (left == right)
          Ok(left)
        else
          Err("different")
      )
    )
}
"
`;

exports[`formatter attaches postfix access to a multiline parenthesized expression 1`] = `
"module Example {
  pure def app(op: (int, int) => int, lhs: int, rhs: int): int = op(lhs, rhs)

  pure def multiply(lhs: int, rhs: int): int =
    ((x, y) =>
      val result = x * y
      if (result > 0) result else 0
    ).app(lhs, rhs)
}
"
`;

exports[`formatter keeps a block-bodied lambda brace beside its arrow 1`] = `
"module Example {
  pure def app(op: (int, int) => int, lhs: int, rhs: int): int = op(lhs, rhs)

  pure def absoluteDifference(lhs: int, rhs: int): int =
    ((x, y) => {
      val result = x - y
      if (result < 0) -result else result
    }).app(lhs, rhs)
}
"
`;

