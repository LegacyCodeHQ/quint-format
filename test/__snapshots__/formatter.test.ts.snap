  type State = { first: int, second: int }
  var state: State

  action update = all {
    state' =
      state.with("first", 1)
          .with("second", 2),
  }
}
"
`;

exports[`formatter preserves an explicit line break after else 1`] = `
"module Example {
  type State = { value: int }

  pure def update(condition: bool, state: State): State =
    if (condition) {
      value: state.value,
    } else
      pure val nextValue = state.value + 1
      {
        value: nextValue,
      }
}
"
`;

