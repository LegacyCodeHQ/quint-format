exports[`formatter indents multiline match-arm bodies below their arms 2`] = `
"module Example {
  type Status = Ready | Waiting
  var status: Status
  var n: int

  action step =
    match status {
      | Ready => all {
          n' = n,
          status' = Waiting,
        }
      | Waiting => all {
          n' = n + 1,
          status' = Ready,
        }
    }
}
"
`;

