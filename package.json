{
  "name": "@legacycodehq/quint-format",
  "version": "0.32.0",
  "description": "An opinionated formatter for the Quint specification language",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "quintfmt": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LegacyCodeHQ/quint-format.git"
  },
  "homepage": "https://github.com/LegacyCodeHQ/quint-format#readme",
  "bugs": {
    "url": "https://github.com/LegacyCodeHQ/quint-format/issues"
  },
  "files": [
    "dist/cli.js",
    "dist/document.js",
    "dist/index.d.ts",
    "dist/index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "biome check . && tsc --noEmit && tsc --project tsconfig.build.json --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "bun test",
    "prepack": "npm run build",
    "prepublishOnly": "bun test && bun run check",
    "test:official": "bun scripts/check-official-examples.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@legacycodehq/tree-sitter-quint": "0.32.0-rc.3",
    "tree-sitter": "0.25.1"
  },
  "trustedDependencies": [
    "@legacycodehq/tree-sitter-quint"
  ]
}
