    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
